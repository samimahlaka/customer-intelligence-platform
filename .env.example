# Required for S3 ingestion (src/ingestion/upload_to_s3.py)
S3_BUCKET_NAME=your-private-cip-bucket-name
AWS_REGION=us-east-1

# Prefer AWS CLI SSO/profiles or IAM roles over long-lived keys.
# If you must use access keys locally, export them in the shell instead of
# committing them:
#   export AWS_ACCESS_KEY_ID=...
#   export AWS_SECRET_ACCESS_KEY=...
#   export AWS_SESSION_TOKEN=...   # if using temporary credentials
