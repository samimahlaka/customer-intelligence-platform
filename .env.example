# Required for S3 ingestion (src/ingestion/upload_to_s3.py)
S3_BUCKET_NAME=your-private-cip-bucket-name
AWS_REGION=us-east-1

# Prefer AWS CLI SSO/profiles or IAM roles over long-lived keys.
# If you must use access keys locally, export them in the shell instead of
# committing them:
#   export AWS_ACCESS_KEY_ID=...
#   export AWS_SECRET_ACCESS_KEY=...
#   export AWS_SESSION_TOKEN=...   # if using temporary credentials

# Required for Snowflake raw load (snowflake/load_from_s3.py)
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=your_user
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=CIP_WH

# Auth: set a password OR a private key path (do not commit secrets)
SNOWFLAKE_PASSWORD=
# SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# S3 auth for the Snowflake external stage:
#   auto (default) — try storage integration, else runtime AWS credentials
#   credentials — always use AWS credential chain at runtime
#   storage_integration — IAM role trust (requires iam:CreateRole / UpdateAssumeRolePolicy)
# SNOWFLAKE_S3_AUTH=auto

# Optional naming overrides for storage-integration mode
# SNOWFLAKE_S3_ROLE_NAME=cip-snowflake-s3-access
# SNOWFLAKE_STORAGE_INTEGRATION=CIP_S3_INTEGRATION
